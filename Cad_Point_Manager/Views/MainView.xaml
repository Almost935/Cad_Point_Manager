<Page x:Class="Cad_Point_Manager.Views.MainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Cad_Point_Manager.Views"
      xmlns:controls="clr-namespace:Cad_Point_Manager.Controls"
      xmlns:converters="clr-namespace:Cad_Point_Manager.Converters"
      xmlns:uc="clr-namespace:Cad_Point_Manager.Views.UserControls"
      xmlns:d3D="clr-namespace:Cad_Point_Manager.Controls.D3DControl"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      xmlns:viewModels="clr-namespace:Cad_Point_Manager.ViewModels"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
      xmlns:pointRendering="clr-namespace:Cad_Point_Manager.Models.PointRendering"
      xmlns:models="clr-namespace:Cad_Point_Manager.Models"
      d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
      mc:Ignorable="d"
      Title="MainView"
      Background="{StaticResource MainBackgroundBrush}"
      d:Width="{x:Static SystemParameters.PrimaryScreenWidth}"
      d:Height="{x:Static SystemParameters.PrimaryScreenHeight}">

    <Page.Resources>
        <Style TargetType="fa:FontAwesome">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <converters:LeftRightMarginConverter x:Key="LeftRightMarginConverter" />
        <converters:Matrix3x2ToWindowsMatrixConverter x:Key="Matrix3x2ToWindowsMatrixConverter" />
        <converters:CenterOffsetConverter x:Key="CenterOffsetConverter" />
        <converters:CogoPointBaseToggleCenterConverter x:Key="CogoPointBaseToggleCenterConverter" />
        <converters:PointTransformer x:Key="PointTransformer" />

        <Thickness x:Key="ToggleButtonMargin">0,5,0,5</Thickness>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="15*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="menuGrid"
              Grid.Row="0">
            <Border Grid.Row="0"
                    BorderBrush="#7FFFFFFF"
                    BorderThickness="0.25"
                    Background="{StaticResource WidgetBrush}">
                <Menu Style="{StaticResource MenuStyle1}">
                    <MenuItem Header="File"
                              Style="{StaticResource MenuItemStyle1}">
                        <MenuItem Header="New"
                                  Command="{Binding NewJobCommand}"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="File" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open"
                                  Command="{Binding LoadJobCommand}"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="FolderOpen" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save"
                                  Command="{Binding SaveJobCommand}"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="Save" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Exit"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="Close" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Insert"
                              Style="{StaticResource MenuItemStyle1}">
                        <MenuItem Header="Insert DXF"
                                  Command="{Binding AttachDxfFileCommand}"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="Paperclip" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Edit"
                              Style="{StaticResource MenuItemStyle1}">
                        <MenuItem Header="Undo"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="Undo" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Redo"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="RotateRight" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="View"
                              Style="{StaticResource MenuItemStyle1}">
                        <MenuItem Header="Zoom In"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="SearchPlus" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zoom Out"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="SearchMinus" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zoom To Extents"
                                  Command="{Binding ZoomToExtentsCommand}"
                                  Style="{StaticResource MenuItemStyle1}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="SquareOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ClipToBounds="False"
              Panel.ZIndex="1">
            <uc:RightHandPopout x:Name="RightSidePopout"
                                Panel.ZIndex="1"
                                Width="300"
                                HorizontalAlignment="Right"
                                ClipToBounds="False"
                                Height="{Binding ElementName=dxfBorder, Path=Height}"
                                CadManager="{Binding JobFileManager.CadManager3D}"
                                LayerCollectionView="{Binding JobFileManager.CadManager3D.LayersView}"
                                PointGroupCollectionView="{Binding JobFileManager.CadManager3D.PointGroupsView}" />
            <uc:LeftHandPopout x:Name="LeftSidePopout"
                               Panel.ZIndex="1"
                               Width="400"
                               HorizontalAlignment="Left"
                               ClipToBounds="False"
                               Height="{Binding ElementName=dxfBorder, Path=Height}"
                               CadManager="{Binding JobFileManager.CadManager3D}"
                               PointsCollectionView="{Binding JobFileManager.CadManager3D.PointsView}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid x:Name="dxfGrid"
                  SizeChanged="dxfGrid_SizeChanged"
                  ClipToBounds="True">
                <Grid.Margin>
                    <MultiBinding Converter="{StaticResource LeftRightMarginConverter}">
                        <Binding ElementName="SourceControl"
                                 Path="Value" />
                        <Binding ElementName="SourceControl"
                                 Path="Value" />
                        <Binding>
                            <Binding.Source>
                                <sys:Double>20</sys:Double>
                            </Binding.Source>
                        </Binding>
                        <Binding>
                            <Binding.Source>
                                <sys:Double>10</sys:Double>
                            </Binding.Source>
                        </Binding>
                    </MultiBinding>
                </Grid.Margin>

                <d3D:D3dDxfControl x:Name="d3dDxfControl"
                                   Cursor="Cross"
                                   CadManager3D="{Binding JobFileManager.CadManager3D}"
                                   Camera="{Binding Camera, Mode=TwoWay}"
                                   SelectedPoints="{Binding SelectedPoints}"
                                   Width="{Binding ElementName=dxfGrid, Path=ActualWidth}"
                                   Height="{Binding ElementName=dxfGrid, Path=ActualHeight}" />

                <Canvas x:Name="BackgroundCanvas">
                    <uc:CogoPointUserControl Width="100"
                                             Height="100"
                                             Canvas.Left="200"
                                             Canvas.Top="100"
                                             PointNumber="100"
                                             Elevation="123.45"
                                             Description="Test Desc"
                                             PointScale="1"/>
                    <ItemsControl x:Name="SelectedPointButtonsItemsControl"
                                  ItemsSource="{Binding SelectedPoints}"
                                  Background="{x:Null}"
                                  Width="{Binding ElementName=BackgroundCanvas, Path=ActualWidth}"
                                  Height="{Binding ElementName=BackgroundCanvas, Path=ActualHeight}"
                                  Panel.ZIndex="10">
                        <ItemsControl.Resources>
                            <sys:Double x:Key="HalfWidth">25</sys:Double>
                            <sys:Double x:Key="HalfHeight">25</sys:Double>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="{x:Null}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pointRendering:CogoPoint}">
                                <uc:CogoPointUserControl PointGroup="{Binding PointGroup}"
                                                         PointScale="{Binding PointScale}"
                                                         PointNumber="{Binding PointNumber}"
                                                         Elevation="{Binding Elevation}"
                                                         Description="{Binding Description}"
                                                         Background="Black"
                                                         Width="100"
                                                         Height="100">
                                    <uc:CogoPointUserControl.RenderTransform>
                                        <TranslateTransform X="200"
                                                            Y="200" />
                                    </uc:CogoPointUserControl.RenderTransform>

                                    <!--<Canvas.Left>
                                        <MultiBinding Converter="{StaticResource CogoPointBaseToggleCenterConverter}"
                                                      ConverterParameter="X">
                                            <Binding Path="PointPosition" />
                                            <Binding Path="DataContext.Camera.D2dMatrix"
                                                     RelativeSource="{RelativeSource AncestorType=Page}" />
                                        </MultiBinding>
                                    </Canvas.Left>
                                    <Canvas.Top>
                                        <MultiBinding Converter="{StaticResource CogoPointBaseToggleCenterConverter}"
                                                      ConverterParameter="Y">
                                            <Binding Path="PointPosition" />
                                            <Binding Path="DataContext.Camera.D2dMatrix"
                                                     RelativeSource="{RelativeSource AncestorType=Page}" />
                                        </MultiBinding>
                                    </Canvas.Top>-->
                                    <!--<uc:CogoPointUserControl.CanvasPosition>
                                        <MultiBinding Converter="{StaticResource PointTransformer}">
                                            <Binding Path="PointPosition" />
                                            <Binding Path="DataContext.Camera.D2dMatrix"
                                                     RelativeSource="{RelativeSource AncestorType=Page}" 
                                                     Converter="{StaticResource Matrix3x2ToWindowsMatrixConverter}"/>
                                        </MultiBinding>
                                    </uc:CogoPointUserControl.CanvasPosition>
                                    <uc:CogoPointUserControl.CanvasTextInfoPosition>
                                        <MultiBinding Converter="{StaticResource PointTransformer}">
                                            <Binding Path="TextInfoLocation" />
                                            <Binding Path="DataContext.Camera.D2dMatrix"
                                                     RelativeSource="{RelativeSource AncestorType=Page}"
                                                     Converter="{StaticResource Matrix3x2ToWindowsMatrixConverter}" />
                                        </MultiBinding>
                                    </uc:CogoPointUserControl.CanvasTextInfoPosition>-->
                                </uc:CogoPointUserControl>
                                <!--<ToggleButton Content="Move"
                                              Width="20"
                                              Height="20"
                                              Background="Red"
                                              IsHitTestVisible="True">
                                    <ToggleButton.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform>
                                                <TranslateTransform.X>
                                                    <MultiBinding Converter="{StaticResource CogoPointBaseToggleCenterConverter}"
                                                                  ConverterParameter="X">
                                                        <Binding Path="PointPosition" />
                                                        <Binding Path="DataContext.Camera.D2dMatrix"
                                                                 RelativeSource="{RelativeSource AncestorType=Page}" />
                                                    </MultiBinding>
                                                </TranslateTransform.X>
                                                <TranslateTransform.Y>
                                                    <MultiBinding Converter="{StaticResource CogoPointBaseToggleCenterConverter}"
                                                                  ConverterParameter="Y">
                                                        <Binding Path="PointPosition" />
                                                        <Binding Path="DataContext.Camera.D2dMatrix"
                                                                 RelativeSource="{RelativeSource AncestorType=Page}" />
                                                    </MultiBinding>
                                                </TranslateTransform.Y>
                                            </TranslateTransform>
                                        </TransformGroup>
                                    </ToggleButton.RenderTransform>
                                </ToggleButton>-->
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="20,0,0,0"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Text="{Binding ElementName=d3dDxfControl, Path=DxfCoordsString}" />
            <WrapPanel Grid.Column="1"
                       Margin="20 0 0 0"
                       HorizontalAlignment="Center">
                <RadioButton x:Name="All"
                             GroupName="SnapToggles"
                             Style="{StaticResource DarkGreyRadioButtonStyle}"
                             Width="40"
                             Height="40"
                             Margin="{StaticResource ToggleButtonMargin}"
                             Command="{Binding SnapToggleCommand}"
                             CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                             IsChecked="True">
                    <RadioButton.Content>
                        <ContentControl Template="{StaticResource EverythingIcon}" />
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="Lines"
                             GroupName="SnapToggles"
                             Style="{StaticResource DarkGreyRadioButtonStyle}"
                             Width="40"
                             Height="40"
                             Margin="{StaticResource ToggleButtonMargin}"
                             Command="{Binding SnapToggleCommand}"
                             CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                    <RadioButton.Content>
                        <ContentControl Template="{StaticResource LineIcon}" />
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="Points"
                             GroupName="SnapToggles"
                             Style="{StaticResource DarkGreyRadioButtonStyle}"
                             Width="40"
                             Height="40"
                             Margin="{StaticResource ToggleButtonMargin}"
                             Command="{Binding SnapToggleCommand}"
                             CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                    <RadioButton.Content>
                        <ContentControl Template="{StaticResource PointsIcon}" />
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="CogoPoints"
                             GroupName="SnapToggles"
                             Style="{StaticResource DarkGreyRadioButtonStyle}"
                             Width="40"
                             Height="40"
                             Margin="{StaticResource ToggleButtonMargin}"
                             Command="{Binding SnapToggleCommand}"
                             CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                    <RadioButton.Content>
                        <ContentControl Template="{StaticResource CogoPointsIcon}" />
                    </RadioButton.Content>
                </RadioButton>
            </WrapPanel>
        </Grid>
    </Grid>
</Page>
