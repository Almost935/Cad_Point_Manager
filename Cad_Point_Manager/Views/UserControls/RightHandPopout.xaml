<UserControl x:Class="Cad_Point_Manager.Views.UserControls.RightHandPopout"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cad_Point_Manager.Views.UserControls"
             xmlns:controls="clr-namespace:Cad_Point_Manager.Controls"
             xmlns:converters="clr-namespace:Cad_Point_Manager.Converters"
             xmlns:viewModels="clr-namespace:Cad_Point_Manager.ViewModels"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:validation="clr-namespace:Cad_Point_Manager.Views.ValidationRules"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:behaviors="clr-namespace:Cad_Point_Manager.Behavior"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="400">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:Vector4ToColorConverter x:Key="Vector4ToColorConverter" />
        <SolidColorBrush x:Key="propertiesFontBrush"
                         Color="Black" />

        <Style x:Key="tabBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource TabBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource TabMouseOverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="overallGrid"
          MouseLeave="OverallGrid_MouseLeave"
          MouseEnter="OverallGrid_MouseEnter"
          Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="mainPanel"
              HorizontalAlignment="Stretch"
              Grid.Column="0"
              Margin="0 0 1 0"
              RenderTransformOrigin="1, 1">
            <ListView x:Name="layersListView"
                      ItemsSource="{Binding ElementName=root, Path=CadManager.LayersView}"
                      Style="{StaticResource UpdatedListViewStyle}"
                      Opacity="{Binding ElementName=root, Path=LayerListOpacity}"
                      IsHitTestVisible="{Binding ElementName=root, Path=LayerListVisible}"
                      SelectionMode="Extended"
                      Loaded="LayersListView_Loaded"
                      SelectionChanged="LayersListView_SelectionChanged"
                      Background="{StaticResource PopoutMenuBackgroundBrush}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <TextBlock Text="Name"
                                           FontSize="{StaticResource ListViewHeaderFontSize}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=Value.Name}"
                                               Foreground="{DynamicResource propertiesFontBrush}"
                                               FontSize="{StaticResource ListViewFontSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Stretch"
                                               Margin="0 0 0 0">
                                        <TextBlock.ToolTip>
                                            <TextBlock Text="{Binding Path=Value.Name}" />
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <TextBlock Text="Color"
                                           FontSize="{StaticResource ListViewHeaderFontSize}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <colorpicker:PortableColorPicker Style="{StaticResource DefaultColorPickerStyle}"
                                                                     SelectedColor="{Binding Value.Color, Converter={StaticResource Vector4ToColorConverter}}"
                                                                     ToggleButtonWidth="20"
                                                                     ToggleButtonHeight="15"
                                                                     ToggleButtonMargin="0 2 0 2"
                                                                     Focusable="True"
                                                                     HorizontalAlignment="Center"
                                                                     IsPopupOpen="{Binding ElementName=root, Path=LayerListColorPickerOpen, Mode=OneWayToSource}"
                                                                     IsPopupOpenChanged="LayersPortableColorPicker_IsPopupOpenChanged" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <TextBlock Text="Visibility"
                                           FontSize="{StaticResource ListViewHeaderFontSize}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Path=Value.IsVisible, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Checked="LayerCheckBox_Checked"
                                              Unchecked="LayerCheckBox_Unchecked" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid x:Name="pointGroupListViewGrid"
                  Opacity="{Binding ElementName=root, Path=PointGroupListOpacity}"
                  HorizontalAlignment="Stretch"
                  IsHitTestVisible="{Binding ElementName=root, Path=PointGroupListVisible}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="pointGroupsListView"
                              Grid.Row="0"
                              ItemsSource="{Binding ElementName=root, Path=CadManager.PointGroupsView}"
                              Style="{StaticResource UpdatedListViewStyle}"
                              IsHitTestVisible="{Binding ElementName=root, Path=PointGroupListVisible}"
                              SelectionMode="Extended"
                              Focusable="True"
                              SelectionChanged="PointGroupsListView_SelectionChanged"
                              PreviewKeyDown="PointGroupsListView_PreviewKeyDownOrUp"
                              PreviewKeyUp="PointGroupsListView_PreviewKeyDownOrUp"
                              Background="{StaticResource PopoutMenuBackgroundBrush}"
                              BorderThickness="0"
                              Loaded="PointGroupsListView_Loaded">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn>
                                    <GridViewColumn.Header>
                                        <TextBlock Text="Name"
                                                   FontSize="{StaticResource ListViewHeaderFontSize}" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="PointGroupNameBorder"
                                                    PreviewMouseLeftButtonDown="PointGroupNameBorder_PreviewMouseLeftButtonDown"
                                                    Focusable="False"
                                                    Margin="0"
                                                    HorizontalAlignment="Stretch">
                                                <TextBox x:Name="PointGroupNameTextBox"
                                                         FontSize="{StaticResource ListViewFontSize}"
                                                         Foreground="{DynamicResource propertiesFontBrush}"
                                                         Style="{StaticResource EditableTextBox}"
                                                         IsReadOnly="True"
                                                         LostFocus="PointGroupNameTextbox_LostFocus"
                                                         PreviewKeyUp="PointGroupNameTextbox_PreviewKeyUp"
                                                         ToolTipService.ShowOnDisabled="True">
                                                    <TextBox.Text>
                                                        <Binding Path="Name"
                                                                 UpdateSourceTrigger="Explicit"
                                                                 Mode="TwoWay"
                                                                 ValidatesOnDataErrors="True"
                                                                 NotifyOnValidationError="True"
                                                                 ValidatesOnExceptions="True"
                                                                 ValidatesOnNotifyDataErrors="True">
                                                            <Binding.ValidationRules>
                                                                <validation:NoIllegalCharactersRule />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn>
                                    <GridViewColumn.Header>
                                        <TextBlock Text="Color"
                                                   FontSize="{StaticResource ListViewHeaderFontSize}" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <colorpicker:PortableColorPicker Style="{StaticResource DefaultColorPickerStyle}"
                                                                             SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                             ToggleButtonWidth="20"
                                                                             ToggleButtonHeight="15"
                                                                             ToggleButtonMargin="0 2 0 2"
                                                                             IsPopupOpen="{Binding ElementName=root, Path=PointGroupListColorPickerOpen, Mode=OneWayToSource}"
                                                                             Focusable="True"
                                                                             HorizontalAlignment="Center"
                                                                             IsPopupOpenChanged="PointGroupsPortableColorPicker_IsPopupOpenChanged" 
                                                                             PreviewMouseLeftButtonDown="PortableColorPicker_PreviewMouseLeftButtonDown"
                                                                             PreviewKeyDown="PortableColorPicker_PreviewKeyDown"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn>
                                    <GridViewColumn.Header>
                                        <Border>
                                            <TextBlock Text="Visibility"
                                                       HorizontalAlignment="Stretch"
                                                       FontSize="{StaticResource ListViewHeaderFontSize}" />
                                        </Border>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <CheckBox IsChecked="{Binding Path=IsVisible, Mode=TwoWay}"
                                                          HorizontalAlignment="Left"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          Unchecked="PointGroupsVisibilityCheckBox_Unchecked"
                                                          Checked="PointGroupsVisibilityCheckBox_Checked"
                                                          PreviewMouseLeftButtonDown="PointGroupsVisibilityCheckBox_PreviewMouseLeftButtonDown"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn>
                                    <GridViewColumn.Header>
                                        <TextBlock Text="Scale"
                                                   FontSize="{StaticResource ListViewHeaderFontSize}" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="PointGroupScaleBorder"
                                                    PreviewMouseLeftButtonDown="PointGroupScaleBorder_PreviewMouseLeftButtonDown"
                                                    Focusable="False"
                                                    BorderBrush="Transparent"
                                                    Background="Transparent"
                                                    HorizontalAlignment="Stretch">
                                                <TextBox x:Name="PointScaleTextbox"
                                                         Style="{StaticResource EditableTextBox}"
                                                         IsReadOnly="true"
                                                         FontSize="{StaticResource ListViewFontSize}"
                                                         HorizontalAlignment="Left"
                                                         LostFocus="PointScaleTextbox_LostFocus"
                                                         PreviewKeyDown="PointScaleTextbox_PreviewKeyUp"
                                                         Opacity="{Binding ElementName=root, Path=PointGroupListOpacity}">
                                                    <TextBox.Text>
                                                        <Binding Path="PointScale"
                                                                 StringFormat="N3"
                                                                 UpdateSourceTrigger="Explicit"
                                                                 Mode="TwoWay"
                                                                 ValidatesOnDataErrors="True"
                                                                 NotifyOnValidationError="True"
                                                                 ValidatesOnExceptions="True"
                                                                 ValidatesOnNotifyDataErrors="True">
                                                            <Binding.ValidationRules>
                                                                <validation:PositiveDoubleValidationRule />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid  Grid.Row="1"
                           Background="{Binding ElementName=pointGroupsListView, Path=Background}">
                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="NewNewPointGroupButton"
                                    Style="{StaticResource BorderWidgetsButton}"
                                    Width="40"
                                    Height="40"
                                    Margin="5 2 5 2"
                                    Click="NewPointGroupButton_Click">
                                <Button.Content>
                                    <ContentControl Template="{StaticResource PlusIcon}" />
                                </Button.Content>
                                <Button.LayoutTransform>
                                    <ScaleTransform ScaleX="0.7"
                                                    ScaleY="0.7" />
                                </Button.LayoutTransform>
                                <Button.ToolTip>
                                    <TextBlock Text="Add New Point Group" />
                                </Button.ToolTip>
                            </Button>
                            <Button Style="{StaticResource BorderWidgetsButton}"
                                    Width="40"
                                    Height="40"
                                    Margin="5 2 5 2">
                                <Button.Content>
                                    <ContentControl Template="{StaticResource CancelIcon}"
                                                    Foreground="White" />
                                </Button.Content>
                                <Button.LayoutTransform>
                                    <ScaleTransform ScaleX="0.7"
                                                    ScaleY="0.7" />
                                </Button.LayoutTransform>
                                <Button.ToolTip>
                                    <TextBlock Text="Add New Point Group" />
                                </Button.ToolTip>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Grid>
                <Grid Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource SemiTransparentTabBrush}">
                    <Grid.Resources>
                        <Thickness x:Key="NewPointGroupMargin">5 2 5 2</Thickness>
                        <Thickness x:Key="RowMargin">10 0 10 0</Thickness>
                        <SolidColorBrush x:Key="TextBlockColor"
                                         Color="White" />
                        <sys:Double x:Key="PointGroupCreationTextSize">12</sys:Double>
                    </Grid.Resources>
                    <Border Grid.Row="0">
                        <Grid Margin="10 3 10 3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Merge Selected Layer to:"
                                       Foreground="{StaticResource TextBlockColor}"
                                       Margin="{StaticResource NewPointGroupMargin}"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource PointGroupCreationTextSize}" />
                            <controls:NoRevertComboBox x:Name="AvailableMergePointGroupsCBox"
                                                       ItemsSource="{Binding ElementName=root, Path=AvailableMergePointGroups}"
                                                       DisplayMemberPath="Key"
                                                       SelectedValuePath="Value"
                                                       Style="{StaticResource ValidationComboBox}"
                                                       SelectedValue="{Binding ElementName=root, Path=MergePointGroup}"
                                                       SelectionChanged="AvailableMergePointGroupsCBox_SelectionChanged"
                                                       Height="25"
                                                       Grid.Column="1"
                                                       Margin="{StaticResource NewPointGroupMargin}">
                                <controls:NoRevertComboBox.ToolTip>
                                    <TextBlock Text="The layer to which the selected layer will be merged." />
                                </controls:NoRevertComboBox.ToolTip>
                            </controls:NoRevertComboBox>
                            <Button x:Name="MergePointGroups"
                                    Style="{StaticResource BorderWidgetsButton}"
                                    Width="40"
                                    Height="40"
                                    Margin="2"
                                    Grid.Column="2"
                                    RenderTransformOrigin="0.5 0.5"
                                    BorderBrush="White"
                                    Click="MergePointGroups_Click">
                                <Button.Content>
                                    <ContentControl Template="{StaticResource MergeIcon}" />
                                </Button.Content>
                                <Button.LayoutTransform>
                                    <ScaleTransform ScaleX="0.7"
                                                    ScaleY="0.7" />
                                </Button.LayoutTransform>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="tab"
                Grid.Column="1"
                Margin="1 0 0 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border  x:Name="layersBorder"
                         Style="{StaticResource tabBorderStyle}"
                         Grid.Row="0"
                         Margin="0 0 0 1"
                         MouseEnter="LayersBorder_MouseEnter">
                    <TextBlock Text="Layers"
                               Style="{StaticResource TabFontStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               RenderTransformOrigin="0.5, 0.5"
                               ClipToBounds="False"
                               Margin="3 0 3 0"
                               Grid.Row="0">
                        <TextBlock.LayoutTransform>
                            <TransformGroup>
                                <RotateTransform Angle="90" />
                                <ScaleTransform ScaleX="-1"
                                                ScaleY="-1" />
                            </TransformGroup>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>
                <Border x:Name="pointGroupsBorder"
                        Style="{StaticResource tabBorderStyle}"
                        Grid.Row="2"
                        Margin="0 1 0 0"
                        MouseEnter="PointGroupsBorder_MouseEnter">
                    <TextBlock Text="Point Groups"
                               Style="{StaticResource TabFontStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               RenderTransformOrigin="0.5, 0.5"
                               ClipToBounds="False"
                               Margin="3 0 3 0">
                        <TextBlock.LayoutTransform>
                            <TransformGroup>
                                <RotateTransform Angle="90" />
                                <ScaleTransform ScaleX="-1"
                                                ScaleY="-1" />
                            </TransformGroup>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
