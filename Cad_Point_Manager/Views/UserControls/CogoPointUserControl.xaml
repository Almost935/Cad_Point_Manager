<UserControl x:Class="Cad_Point_Manager.Views.UserControls.CogoPointUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cad_Point_Manager.Views.UserControls"
             xmlns:converters="clr-namespace:Cad_Point_Manager.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <converters:Vector4ToBrushConverter x:Key="Vector4ToBrushConverter" />
        <converters:CenterOffsetConverter x:Key="CenterOffsetConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <sys:Double x:Key="StandardLineHeight">12</sys:Double>
    </UserControl.Resources>
    <Canvas RenderTransformOrigin="0, 1"
            Width="10"
            Height="10"
            Canvas.Left="0"
            Canvas.Top="0"
            Background="#310047FF">
        <Canvas.RenderTransform>
            <ScaleTransform ScaleX="{Binding PointScale, FallbackValue=1}"
                            ScaleY="{Binding PointScale, FallbackValue=1}" />
        </Canvas.RenderTransform>
        <Ellipse x:Name="PointMarker"
                 Fill="{Binding PointGroup.Color, Converter={StaticResource Vector4ToBrushConverter}, FallbackValue=Red}"
                 Height="2"
                 Width="2">
            <Canvas.Left>
                <MultiBinding Converter="{StaticResource CenterOffsetConverter}" FallbackValue="-1">
                    <Binding Path="Position" />
                    <Binding ElementName="PointMarker"
                             Path="Width"/>
                </MultiBinding>
            </Canvas.Left>
            <Canvas.Top>
                <MultiBinding Converter="{StaticResource CenterOffsetConverter}"
                              FallbackValue="-1">
                    <Binding Path="Position" />
                    <Binding ElementName="PointMarker"
                             Path="Height" />
                </MultiBinding>
            </Canvas.Top>
        </Ellipse>
        <StackPanel Canvas.Left="{Binding TextInfoPosition.X}"
                    Canvas.Top="{Binding TextInfoPosition.Y}"
                    Margin="4 -33 0 0">
            <TextBlock Text="{Binding PointNumber, FallbackValue=1}"
                       Foreground="{Binding PointGroup.Color, Converter={StaticResource Vector4ToBrushConverter}, FallbackValue=Red}"
                       Visibility="{Binding PointNumberIsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                       LineStackingStrategy="BlockLineHeight"
                       LineHeight="{StaticResource StandardLineHeight}"
                       FontSize="12" />
            <TextBlock Text="{Binding Elevation, FallbackValue=0.000}"
                       Foreground="{Binding PointGroup.Color, Converter={StaticResource Vector4ToBrushConverter}, FallbackValue=Red}"
                       Visibility="{Binding ElevationIsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                       LineStackingStrategy="BlockLineHeight"
                       LineHeight="{StaticResource StandardLineHeight}"
                       FontSize="12" />
            <TextBlock Text="{Binding Description, FallbackValue=Points}"
                       Foreground="{Binding PointGroup.Color, Converter={StaticResource Vector4ToBrushConverter}, FallbackValue=Red}"
                       Visibility="{Binding DescriptionIsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                       LineStackingStrategy="BlockLineHeight"
                       LineHeight="{StaticResource StandardLineHeight}"
                       FontSize="12" />
        </StackPanel>
    </Canvas>
</UserControl>
