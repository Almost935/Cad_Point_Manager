<UserControl x:Class="Cad_Point_Manager.Views.UserControls.SignificantPointControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cad_Point_Manager.Views.UserControls"
             xmlns:converters="clr-namespace:Cad_Point_Manager.Converters"
             mc:Ignorable="d"
             DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <converters:SignificantPointColorConverter x:Key="SignificantPointColorConverter" />
        <converters:MultiplicationConverter x:Key="MultiplicationConverter" />

        <Style x:Key="SnapIconStyle"
               TargetType="ContentControl">
            <!-- Default: no template -->
            <Setter Property="Template"
                    Value="{x:Null}" />

            <Style.Triggers>
                <!-- Show MidPoint icon -->
                <DataTrigger Binding="{Binding HitTestablePoint.PointType}"
                             Value="MidPoint">
                    <Setter Property="Template"
                            Value="{StaticResource MidPointSnapIcon}" />
                </DataTrigger>

                <!-- Show EndPoint icon -->
                <DataTrigger Binding="{Binding HitTestablePoint.PointType}"
                             Value="EndPoint">
                    <Setter Property="Template"
                            Value="{StaticResource EndSnapIcon}" />
                </DataTrigger>

                <!-- Show Intersection icon -->
                <DataTrigger Binding="{Binding HitTestablePoint.PointType}"
                             Value="Intersection">
                    <Setter Property="Template"
                            Value="{StaticResource IntersectionSnapIcon}" />
                </DataTrigger>

                <!-- When HitTestablePoint is null, ensure no icon is shown -->
                <DataTrigger Binding="{Binding HitTestablePoint}"
                             Value="{x:Null}">
                    <Setter Property="Template"
                            Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--<Style x:Key="EllipseStyle"
               TargetType="Ellipse">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HitTestablePoint.IsSelected}"
                             Value="True">
                    <Setter Property="Fill"
                            Value="{StaticResource MouseOverHitTestablePointBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>-->
    </UserControl.Resources>

    <Grid Height="{StaticResource SignificantPointPixelDiameter}"
          Width="{StaticResource SignificantPointPixelDiameter}">
        <Ellipse x:Name="pointEllipse"
                 Height="{StaticResource SignificantPointPixelDiameter}"
                 Width="{StaticResource SignificantPointPixelDiameter}"
                 Fill="{StaticResource MouseOverHitTestablePointBrush}">
            <Ellipse.RenderTransform>
                <TranslateTransform X="{Binding Source={StaticResource SignificantPointPixelDiameter}, Converter={StaticResource MultiplicationConverter}, ConverterParameter=-0.5}"
                                    Y="{Binding Source={StaticResource SignificantPointPixelDiameter}, Converter={StaticResource MultiplicationConverter}, ConverterParameter=-0.5}" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <ContentControl Margin="20 -40 0 0"
                        Style="{StaticResource SnapIconStyle}" />
    </Grid>
</UserControl>
