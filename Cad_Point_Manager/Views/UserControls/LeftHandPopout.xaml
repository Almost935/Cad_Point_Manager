<UserControl x:Class="Cad_Point_Manager.Views.UserControls.LeftHandPopout"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cad_Point_Manager.Views.UserControls"
             xmlns:controls="clr-namespace:Cad_Point_Manager.Controls"
             xmlns:converters="clr-namespace:Cad_Point_Manager.Converters"
             xmlns:viewModels="clr-namespace:Cad_Point_Manager.ViewModels"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:validation="clr-namespace:Cad_Point_Manager.Views.ValidationRules"
             xmlns:viewsAssorted="clr-namespace:Cad_Point_Manager.Views.Assorted"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="400">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"
                                              CollapseWhenFalse="True" />
        <validation:PointNumberValidationRule x:Key="PointNumberValidationRule" />
        <validation:DoubleValidationRule x:Key="DoubleValidationRule" />

        <SolidColorBrush x:Key="propertiesFontBrush"
                         Color="Black" />

        <Style x:Key="tabBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource TabBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource TabMouseOverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="overallGrid"
          Margin="2"
          MouseLeave="OverallGrid_MouseLeave"
          MouseEnter="OverallGrid_MouseEnter">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="tab"
                Grid.Column="0"
                Margin="0 0 1 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border  x:Name="pointsBorder"
                         Style="{StaticResource tabBorderStyle}"
                         Grid.Row="0"
                         Margin="0 0 0 1"
                         MouseEnter="PointsBorder_MouseEnter">
                    <TextBlock Text="Points"
                               Style="{StaticResource TabFontStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               RenderTransformOrigin="0.5, 0.5"
                               Margin="3 0 3 0"
                               ClipToBounds="False">
                        <TextBlock.LayoutTransform>
                            <TransformGroup>
                                <RotateTransform Angle="90" />
                                <ScaleTransform ScaleX="-1"
                                                ScaleY="-1" />
                            </TransformGroup>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>
                <Border  x:Name="propertiesBorder"
                         Style="{StaticResource tabBorderStyle}"
                         Grid.Row="1"
                         Margin="0 1 0 1"
                         MouseEnter="PropertiesBorder_MouseEnter">
                    <TextBlock Text="Properties"
                               Style="{StaticResource TabFontStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               RenderTransformOrigin="0.5, 0.5"
                               Margin="3 0 3 0"
                               ClipToBounds="False">
                        <TextBlock.LayoutTransform>
                            <TransformGroup>
                                <RotateTransform Angle="90" />
                                <ScaleTransform ScaleX="-1"
                                                ScaleY="-1" />
                            </TransformGroup>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>
                <Border  x:Name="viewsBorder"
                         Style="{StaticResource tabBorderStyle}"
                         Grid.Row="2"
                         Margin="0 1 0 0"
                         MouseEnter="ScenesBorder_MouseEnter">
                    <TextBlock Text="Views"
                               Style="{StaticResource TabFontStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               RenderTransformOrigin="0.5, 0.5"
                               ClipToBounds="False"
                               Margin="3 0 3 0">
                        <TextBlock.LayoutTransform>
                            <TransformGroup>
                                <RotateTransform Angle="90" />
                                <ScaleTransform ScaleX="-1"
                                                ScaleY="-1" />
                            </TransformGroup>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="mainPanel"
              HorizontalAlignment="Stretch"
              Grid.Column="1"
              Margin="1 0 0 0"
              RenderTransformOrigin="0,1">
            <controls:SortableListView x:Name="pointsListView"
                                       Grid.Row="0"
                                       Background="{StaticResource PopoutMenuBackgroundBrush}"
                                       Opacity="{Binding ElementName=root, Path=PointsTabOpacity}"
                                       ItemsSource="{Binding ElementName=root, Path=CadManager.GroupedPointsView}"
                                       Style="{StaticResource UpdatedListViewStyle}"
                                       Visibility="{Binding ElementName=root, Path=PointsTabVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                       IsColumnHeaderHitTestVisible="False"
                                       SelectionMode="Extended"
                                       Loaded="PointsListView_Loaded"
                                       SelectionChanged="PointsListView_SelectionChanged"
                                       VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                       VirtualizingPanel.ScrollUnit="Item"
                                       ScrollViewer.CanContentScroll="True"
                                       VirtualizingStackPanel.IsVirtualizing="True"
                                       VirtualizingStackPanel.VirtualizationMode="Recycling"
                                       VirtualizingStackPanel.IsContainerVirtualizable="True"
                                       ContextMenuOpening="PointsListView_ContextMenuOpening"
                                       ContextMenuClosing="PointsListView_ContextMenuClosing">
                <controls:SortableListView.Resources>
                    <Thickness x:Key="TextboxPadding">0 1 0 1</Thickness>
                    <Thickness x:Key="TextblockPadding">3 1 3 2</Thickness>
                    <SolidColorBrush x:Key="HeaderForeground"
                                     Color="White" />
                    <SolidColorBrush x:Key="BodyForeground"
                                     Color="Black" />
                    <SolidColorBrush x:Key="ReadOnlyBodyForeground"
                                     Color="#FF545454" />
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="VerticalAlignment"
                                Value="Center" />
                    </Style>
                    <Style x:Key="InlineEditBoxStyle"
                           TargetType="TextBox"
                           BasedOn="{StaticResource EditableTextBox}">
                        <Setter Property="VerticalAlignment"
                                Value="Center" />
                        <Setter Property="Padding"
                                Value="{StaticResource TextboxPadding}" />
                        <Setter Property="FontSize"
                                Value="{StaticResource ListViewFontSize}" />
                        <Setter Property="Foreground"
                                Value="{StaticResource BodyForeground}" />
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <EventSetter Event="PreviewKeyDown"
                                     Handler="PointsListInlineEditBox_PreviewKeyDown" />
                        <EventSetter Event="LostFocus"
                                     Handler="InlineEditBox_LostFocus" />
                    </Style>
                    <Style x:Key="InlineTextBlockStyle"
                           TargetType="TextBlock">
                        <Setter Property="VerticalAlignment"
                                Value="Center" />
                        <Setter Property="Margin"
                                Value="{StaticResource TextblockPadding}" />
                        <Setter Property="FontSize"
                                Value="{StaticResource ListViewFontSize}" />
                        <Setter Property="Foreground"
                                Value="{StaticResource BodyForeground}" />
                        <EventSetter Event="MouseDown"
                                     Handler="PointsCellDisplay_MouseDown" />
                    </Style>
                </controls:SortableListView.Resources>
                <controls:SortableListView.ContextMenu>
                    <ContextMenu x:Name="pointsListViewContextMenu"
                                 Style="{StaticResource Win11ContextMenuStyle}"
                                 HasDropShadow="True">
                        <MenuItem Header="New"
                                  Click="PointsListViewNewPoint_Click"
                                  Style="{StaticResource DefaultContextMenuItemStyle}"
                                  InputGestureText="Ctrl+Shift+N">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="Plus"
                                                Foreground="{StaticResource BodyForeground}">
                                    <fa:FontAwesome.LayoutTransform>
                                        <ScaleTransform ScaleX="1.3"
                                                        ScaleY="1.3" />
                                    </fa:FontAwesome.LayoutTransform>
                                </fa:FontAwesome>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Edit"
                                  Click="PointsListViewEditPoint_Click"
                                  Style="{StaticResource DefaultContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="Edit"
                                                Foreground="Black">
                                    <fa:FontAwesome.LayoutTransform>
                                        <ScaleTransform ScaleX="1.3"
                                                        ScaleY="1.3" />
                                    </fa:FontAwesome.LayoutTransform>
                                </fa:FontAwesome>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Delete"
                                  Click="PointsListViewDeletePoint_Click"
                                  Style="{StaticResource DefaultContextMenuItemStyle}"
                                  InputGestureText="Del">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="Trash"
                                                RenderTransformOrigin="0.5 0.5"
                                                Foreground="Black">
                                    <fa:FontAwesome.LayoutTransform>
                                        <ScaleTransform ScaleX="1.3"
                                                        ScaleY="1.3" />
                                    </fa:FontAwesome.LayoutTransform>
                                </fa:FontAwesome>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Style="{StaticResource Win11SeparatorStyle}" />
                        <MenuItem Header="Zoom to Point"
                                  Style="{StaticResource DefaultContextMenuItemStyle}"
                                  Click="PointsListViewZoomPoint_Click">
                            <MenuItem.Icon>
                                <fa:FontAwesome Icon="Camera"
                                                RenderTransformOrigin="0.5 0.5"
                                                Foreground="Black">
                                    <fa:FontAwesome.LayoutTransform>
                                        <ScaleTransform ScaleX="1.3"
                                                        ScaleY="1.3" />
                                    </fa:FontAwesome.LayoutTransform>
                                </fa:FontAwesome>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </controls:SortableListView.ContextMenu>
                <controls:SortableListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                VirtualizingPanel.VirtualizationMode="Recycling"
                                                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                VirtualizingPanel.ScrollUnit="Pixel"
                                                VirtualizingPanel.CacheLength="0 0" />
                    </ItemsPanelTemplate>
                </controls:SortableListView.ItemsPanel>
                <controls:SortableListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"
                           BasedOn="{StaticResource UpdatedListViewItemStyle}">
                        <Setter Property="Height"
                                Value="22" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Stretch" />
                    </Style>
                </controls:SortableListView.ItemContainerStyle>
                <controls:SortableListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource UpdatedGridViewColumnHeaderStyle}">
                        <GridViewColumn Header="No.">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="pointNumber">
                                        <TextBlock x:Name="tbDisplay"
                                                   Text="{Binding PointNumber}"
                                                   Style="{StaticResource InlineTextBlockStyle}" />
                                        <TextBox x:Name="pointNumberEdit"
                                                 Text="{Binding PointNumber, UpdateSourceTrigger=Explicit}"
                                                 Style="{StaticResource InlineEditBoxStyle}" />
                                        <!--<Grid.ToolTip>
                                <TextBlock Text="{Binding PointNumber}" />
                            </Grid.ToolTip>-->
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(viewsAssorted:InlineEdit.EditingField)}"
                                                     Value="PointNumber">
                                            <Setter TargetName="tbDisplay"
                                                    Property="Visibility"
                                                    Value="Collapsed" />
                                            <Setter TargetName="pointNumberEdit"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Northing">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="northing">
                                        <TextBlock x:Name="tbDisplay"
                                                   Text="{Binding Northing,StringFormat=N3}"
                                                   Style="{StaticResource InlineTextBlockStyle}" />
                                        <TextBox x:Name="pointNorthingEdit"
                                                 Text="{Binding Northing, UpdateSourceTrigger=Explicit, StringFormat=N3}"
                                                 Style="{StaticResource InlineEditBoxStyle}" />
                                        <!--<Grid.ToolTip>
                                <TextBlock Text="{Binding Northing, StringFormat=N3}" />
                            </Grid.ToolTip>-->
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(viewsAssorted:InlineEdit.EditingField)}"
                                                     Value="Northing">
                                            <Setter TargetName="tbDisplay"
                                                    Property="Visibility"
                                                    Value="Collapsed" />
                                            <Setter TargetName="pointNorthingEdit"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Easting">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="easting">
                                        <TextBlock x:Name="tbDisplay"
                                                   Text="{Binding Easting, StringFormat=N3}"
                                                   Style="{StaticResource InlineTextBlockStyle}" />
                                        <TextBox x:Name="pointEastingEdit"
                                                 Text="{Binding Easting, UpdateSourceTrigger=Explicit, StringFormat=N3}"
                                                 Style="{StaticResource InlineEditBoxStyle}" />
                                        <!--<Grid.ToolTip>
                                <TextBlock Text="{Binding Easting, StringFormat=N3}" />
                            </Grid.ToolTip>-->
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(viewsAssorted:InlineEdit.EditingField)}"
                                                     Value="Easting">
                                            <Setter TargetName="tbDisplay"
                                                    Property="Visibility"
                                                    Value="Collapsed" />
                                            <Setter TargetName="pointEastingEdit"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Elevation">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="elevation">
                                        <TextBlock x:Name="tbDisplay"
                                                   Text="{Binding Elevation, StringFormat=N3}"
                                                   Style="{StaticResource InlineTextBlockStyle}" />
                                        <TextBox x:Name="pointElevationEdit"
                                                 Text="{Binding Elevation, UpdateSourceTrigger=Explicit, StringFormat=N3}"
                                                 Style="{StaticResource InlineEditBoxStyle}" />
                                        <!--<Grid.ToolTip>
                                <TextBlock Text="{Binding Elevation, StringFormat=N3}" />
                            </Grid.ToolTip>-->
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(viewsAssorted:InlineEdit.EditingField)}"
                                                     Value="Elevation">
                                            <Setter TargetName="tbDisplay"
                                                    Property="Visibility"
                                                    Value="Collapsed" />
                                            <Setter TargetName="pointElevationEdit"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Description">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="description">
                                        <TextBlock x:Name="tbDisplay"
                                                   Text="{Binding Description}"
                                                   Style="{StaticResource InlineTextBlockStyle}" />
                                        <TextBox x:Name="pointDescriptionEdit"
                                                 Text="{Binding Description, UpdateSourceTrigger=Explicit}"
                                                 Style="{StaticResource InlineEditBoxStyle}" />
                                        <!--<Grid.ToolTip>
                                <TextBlock Text="{Binding Description}" />
                            </Grid.ToolTip>-->
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(viewsAssorted:InlineEdit.EditingField)}"
                                                     Value="Description">
                                            <Setter TargetName="tbDisplay"
                                                    Property="Visibility"
                                                    Value="Collapsed" />
                                            <Setter TargetName="pointDescriptionEdit"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </controls:SortableListView.View>
                <controls:SortableListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                                        VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                        VirtualizingPanel.ScrollUnit="Pixel"
                                                        VirtualizingPanel.CacheLength="0 0" />
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="False"
                                                      Style="{StaticResource ListViewExpanderStyle}"
                                                      Margin="0 1 0 1"
                                                      HorizontalAlignment="Left"
                                                      Header="{Binding Name.Name}"
                                                      FontSize="{StaticResource ListViewHeaderFontSize}">
                                                <ItemsPresenter SnapsToDevicePixels="True"
                                                                UseLayoutRounding="True" />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </controls:SortableListView.GroupStyle>
            </controls:SortableListView>
            <Grid x:Name="PropertiesGrid"
                  Opacity="{Binding ElementName=root, Path=PropertiesTabOpacity}"
                  Visibility="{Binding ElementName=root, Path=PropertiesTabVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="{StaticResource PopoutMenuBackgroundBrush}"
                  DataContext="{Binding ElementName=root, Path=CogoPointSelectionViewModel}">
                <Grid.Resources>
                    <Thickness x:Key="RowMargin">10 0 10 0</Thickness>
                    <Thickness x:Key="RowItemMargin">2</Thickness>
                    <sys:Double x:Key="PropertiesTabTextSize">12</sys:Double>
                </Grid.Resources>
                <StackPanel Margin="5 10 5 10">
                    <Grid Margin="{StaticResource RowItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Selection Count:"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource PropertiesTabTextSize}"
                                   Margin="2,0,2,0" />
                        <TextBlock x:Name="PropertiesSelectionCountTextBlock"
                                   Text="{Binding SelectedPoints.Count}"
                                   Grid.Column="1"
                                   Height="20"
                                   FontSize="{StaticResource PropertiesTabTextSize}"
                                   Margin="2,2,2,2" />
                    </Grid>
                    <Grid Margin="{StaticResource RowItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Point Number:"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource PropertiesTabTextSize}"
                                   Margin="2,0,2,0" />
                        <TextBox x:Name="PropertiesPointNumberTextBox"
                                 Text="{Binding Path=PointNumber, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                 Style="{StaticResource ValidationTextBox}"
                                 Grid.Column="2"
                                 Height="20"
                                 FontSize="{StaticResource PropertiesTabTextSize}"
                                 Margin="2,2,2,2"
                                 IsEnabled="{Binding IsPointNumberEditable}"
                                 PreviewMouseLeftButtonDown="PropertiesTextBox_PreviewMouseLeftButtonDown"
                                 GotKeyboardFocus="PropertiesTextBox_GotKeyboardFocus"
                                 LostFocus="PropertiesPointNumberTextBox_LostFocus"
                                 TextChanged="PropertiesPointNumberTextBox_TextChanged"
                                 PreviewKeyUp="PropertiesPointNumberTextBox_PreviewKeyUp" />
                    </Grid>
                    <Grid Margin="{StaticResource RowItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Northing:"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource PropertiesTabTextSize}"
                                   Margin="{StaticResource RowItemMargin}" />
                        <TextBox x:Name="PropertiesNorthingTextBox"
                                 Style="{StaticResource ValidationTextBox}"
                                 Text="{Binding Northing, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                 Grid.Column="1"
                                 Height="20"
                                 FontSize="{StaticResource PropertiesTabTextSize}"
                                 Margin="{StaticResource RowItemMargin}"
                                 IsEnabled="{Binding IsCoordinateEditable}"
                                 PreviewMouseLeftButtonDown="PropertiesTextBox_PreviewMouseLeftButtonDown"
                                 GotKeyboardFocus="PropertiesTextBox_GotKeyboardFocus"
                                 LostFocus="PropertiesNorthingTextBox_LostFocus"
                                 TextChanged="PropertiesNorthingTextBox_TextChanged"
                                 PreviewKeyUp="PropertiesNorthingTextBox_PreviewKeyUp" />
                    </Grid>
                    <Grid Margin="{StaticResource RowItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Easting:"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource PropertiesTabTextSize}"
                                   Margin="{StaticResource RowItemMargin}" />
                        <TextBox x:Name="PropertiesEastingTextBox"
                                 Style="{StaticResource ValidationTextBox}"
                                 Text="{Binding Easting, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                 Grid.Column="1"
                                 Height="20"
                                 FontSize="{StaticResource PropertiesTabTextSize}"
                                 Margin="{StaticResource RowItemMargin}"
                                 IsEnabled="{Binding IsCoordinateEditable}"
                                 PreviewMouseLeftButtonDown="PropertiesTextBox_PreviewMouseLeftButtonDown"
                                 GotKeyboardFocus="PropertiesTextBox_GotKeyboardFocus"
                                 LostFocus="PropertiesEastingTextBox_LostFocus"
                                 TextChanged="PropertiesEastingTextBox_TextChanged"
                                 PreviewKeyUp="PropertiesEastingTextBox_PreviewKeyUp" />
                    </Grid>
                    <Grid Margin="{StaticResource RowItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Elevation:"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource PropertiesTabTextSize}"
                                   Margin="{StaticResource RowItemMargin}" />
                        <TextBox x:Name="PropertiesElevationTextBox"
                                 Style="{StaticResource ValidationTextBox}"
                                 Text="{Binding Elevation, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                 Grid.Column="1"
                                 Height="20"
                                 FontSize="{StaticResource PropertiesTabTextSize}"
                                 Margin="{StaticResource RowItemMargin}"
                                 IsEnabled="{Binding IsCoordinateEditable}"
                                 PreviewMouseLeftButtonDown="PropertiesTextBox_PreviewMouseLeftButtonDown"
                                 GotKeyboardFocus="PropertiesTextBox_GotKeyboardFocus"
                                 LostFocus="PropertiesElevationTextBox_LostFocus"
                                 TextChanged="PropertiesElevationTextBox_TextChanged"
                                 PreviewKeyUp="PropertiesElevationTextBox_PreviewKeyUp" />
                    </Grid>
                    <Grid Margin="{StaticResource RowItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Description:"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource PropertiesTabTextSize}"
                                   Margin="{StaticResource RowItemMargin}" />
                        <TextBox x:Name="PropertiesDescriptionTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource ValidationTextBox}"
                                 Height="20"
                                 FontSize="{StaticResource PropertiesTabTextSize}"
                                 Margin="{StaticResource RowItemMargin}"
                                 Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                 IsEnabled="{Binding IsDescriptionEditable}"
                                 PreviewMouseLeftButtonDown="PropertiesTextBox_PreviewMouseLeftButtonDown"
                                 GotKeyboardFocus="PropertiesTextBox_GotKeyboardFocus"
                                 LostFocus="PropertiesDescriptionTextBox_LostFocus"
                                 TextChanged="PropertiesDescriptionTextBox_TextChanged"
                                 PreviewKeyUp="PropertiesDescriptionTextBox_PreviewKeyUp" />
                    </Grid>
                    <Grid Margin="{StaticResource RowItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Point Group:"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource PropertiesTabTextSize}"
                                   Margin="{StaticResource RowItemMargin}" />
                        <controls:NoRevertComboBox x:Name="PropertiesPointGroupComboBox"
                                                   Grid.Column="1"
                                                   Height="20"
                                                   Style="{StaticResource ValidationComboBox}"
                                                   FontSize="{StaticResource PropertiesTabTextSize}"
                                                   Margin="{StaticResource RowItemMargin}"
                                                   ItemsSource="{Binding DisplayedPointGroupsName}"
                                                   IsEnabled="{Binding IsPointGroupEditable}"
                                                   SelectedItem="{Binding PointGroup}"
                                                   SelectionChanged="PropertiesPointGroupComboBox_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid Background="{StaticResource PopoutMenuBackgroundBrush}"
                  Opacity="{Binding ElementName=root, Path=ViewsTabOpacity}"
                  Visibility="{Binding ElementName=root, Path=ViewsTabVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:SortableListView x:Name="scenesListView"
                                           ItemsSource="{Binding ElementName=root, Path=Camera.Scenes}"
                                           Style="{StaticResource UpdatedListViewStyle}"
                                           Background="{StaticResource PopoutMenuBackgroundBrush}"
                                           IsColumnHeaderHitTestVisible="False"
                                           SelectionMode="Extended"
                                           VirtualizingPanel.IsVirtualizing="True"
                                           VirtualizingPanel.VirtualizationMode="Recycling"
                                           VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                           VirtualizingPanel.ScrollUnit="Pixel"
                                           Loaded="ScenesListView_Loaded"
                                           SelectionChanged="ScenesListView_SelectionChanged"
                                           Grid.RowSpan="2"
                                           ContextMenuOpening="ScenesListView_ContextMenuOpening"
                                           ContextMenuClosing="ScenesListView_ContextMenuClosing">
                    <controls:SortableListView.Resources>
                        <Thickness x:Key="TextboxPadding">0 1 0 1</Thickness>
                        <Thickness x:Key="TextblockPadding">3 1 3 2</Thickness>
                        <SolidColorBrush x:Key="HeaderForeground"
                                         Color="White" />
                        <SolidColorBrush x:Key="BodyForeground"
                                         Color="Black" />
                        <SolidColorBrush x:Key="ReadOnlyBodyForeground"
                                         Color="#FF545454" />
                        <Style x:Key="InlineEditBoxStyle"
                               TargetType="TextBox"
                               BasedOn="{StaticResource EditableTextBox}">
                            <Setter Property="Padding"
                                    Value="{StaticResource TextboxPadding}" />
                            <Setter Property="FontSize"
                                    Value="{StaticResource ListViewFontSize}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource BodyForeground}" />
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                            <Setter Property="VerticalContentAlignment"
                                    Value="Center" />
                            <EventSetter Event="PreviewKeyDown"
                                         Handler="ScenesListInlineEditBox_PreviewKeyDown" />
                            <EventSetter Event="LostFocus"
                                         Handler="InlineEditBox_LostFocus" />
                        </Style>
                        <Style x:Key="InlineTextBlockStyle"
                               TargetType="TextBlock">
                            <Setter Property="Margin"
                                    Value="{StaticResource TextblockPadding}" />
                            <Setter Property="FontSize"
                                    Value="{StaticResource ListViewFontSize}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource BodyForeground}" />
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                            <EventSetter Event="MouseDown"
                                         Handler="ScenesCellDisplay_MouseDown" />
                        </Style>
                        <Style x:Key="BaseTextBlockStyle"
                               TargetType="TextBlock">
                            <Setter Property="Margin"
                                    Value="{StaticResource TextblockPadding}" />
                            <Setter Property="FontSize"
                                    Value="{StaticResource ListViewFontSize}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource BodyForeground}" />
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                        </Style>
                        <Style x:Key="HeaderTextBlockStyle"
                               TargetType="TextBlock">
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                            <Setter Property="FontSize"
                                    Value="{StaticResource ListViewHeaderFontSize}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource HeaderForeground}" />
                            <Setter Property="TextAlignment"
                                    Value="Center" />
                        </Style>
                    </controls:SortableListView.Resources>
                    <controls:SortableListView.ContextMenu>
                        <ContextMenu x:Name="scenesListViewContextMenu"
                                     Style="{StaticResource Win11ContextMenuStyle}"
                                     HasDropShadow="True">
                            <MenuItem Header="New"
                                      Click="ScenesListNewMenuItem_Click"
                                      Style="{StaticResource DefaultContextMenuItemStyle}"
                                      InputGestureText="F2">
                                <MenuItem.Icon>
                                    <fa:FontAwesome Icon="Plus"
                                                    Foreground="Black">
                                        <fa:FontAwesome.LayoutTransform>
                                            <ScaleTransform ScaleX="1.3"
                                                            ScaleY="1.3" />
                                        </fa:FontAwesome.LayoutTransform>
                                    </fa:FontAwesome>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Rename"
                                      Click="ScenesListRenameMenuItem_Click"
                                      Style="{StaticResource DefaultContextMenuItemStyle}"
                                      InputGestureText="F2">
                                <MenuItem.Icon>
                                    <fa:FontAwesome Icon="ICursor"
                                                    Foreground="Black">
                                        <fa:FontAwesome.LayoutTransform>
                                            <ScaleTransform ScaleX="1.3"
                                                            ScaleY="1.3" />
                                        </fa:FontAwesome.LayoutTransform>
                                    </fa:FontAwesome>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete"
                                      Click="ScenesListDeleteMenuItem_Click"
                                      Style="{StaticResource DefaultContextMenuItemStyle}"
                                      InputGestureText="Del">
                                <MenuItem.Icon>
                                    <fa:FontAwesome Icon="Trash"
                                                    RenderTransformOrigin="0.5 0.5"
                                                    Foreground="Black">
                                        <fa:FontAwesome.LayoutTransform>
                                            <ScaleTransform ScaleX="1.3"
                                                            ScaleY="1.3" />
                                        </fa:FontAwesome.LayoutTransform>
                                    </fa:FontAwesome>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource Win11SeparatorStyle}" />
                            <MenuItem Header="Zoom to View"
                                      Click="ScenesListZoomMenuItem_Click"
                                      Style="{StaticResource DefaultContextMenuItemStyle}">
                                <MenuItem.Icon>
                                    <fa:FontAwesome Icon="Camera"
                                                    RenderTransformOrigin="0.5 0.5"
                                                    Foreground="Black">
                                        <fa:FontAwesome.LayoutTransform>
                                            <ScaleTransform ScaleX="1.3"
                                                            ScaleY="1.3" />
                                        </fa:FontAwesome.LayoutTransform>
                                    </fa:FontAwesome>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </controls:SortableListView.ContextMenu>
                    <controls:SortableListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource UpdatedGridViewColumnHeaderStyle}">
                            <GridViewColumn Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="sceneNameGrid">
                                            <TextBlock x:Name="sceneNameDisplay"
                                                       Text="{Binding Name}"
                                                       Style="{StaticResource InlineTextBlockStyle}" />
                                            <TextBox x:Name="sceneNameEdit"
                                                     Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                                                     Style="{StaticResource InlineEditBoxStyle}"
                                                     HorizontalAlignment="Stretch" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(viewsAssorted:InlineEdit.EditingField)}"
                                                         Value="Name">
                                                <Setter TargetName="sceneNameDisplay"
                                                        Property="Visibility"
                                                        Value="Collapsed" />
                                                <Setter TargetName="sceneNameEdit"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Left">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding BoundsLeft, StringFormat=N3}"
                                                       Style="{StaticResource BaseTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Right">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BoundsRight, StringFormat=N3}"
                                                   Style="{StaticResource BaseTextBlockStyle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Bottom">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding BoundsTop, StringFormat=N3}"
                                                       Style="{StaticResource BaseTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Top">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding BoundsBottom, StringFormat=N3}"
                                                       Style="{StaticResource BaseTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </controls:SortableListView.View>
                    <controls:SortableListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"
                               BasedOn="{StaticResource UpdatedListViewItemStyle}">
                            <Setter Property="Height"
                                    Value="22" />
                            <Setter Property="VerticalContentAlignment"
                                    Value="Stretch" />
                        </Style>
                    </controls:SortableListView.ItemContainerStyle>
                </controls:SortableListView>
                <WrapPanel HorizontalAlignment="Center"
                           Grid.Row="1">
                    <Button x:Name="NewSceneButton"
                            Style="{StaticResource BorderWidgetsButton}"
                            Width="40"
                            Height="40"
                            Margin="5 2 5 2"
                            Click="NewSceneButton_Click">
                        <Button.Content>
                            <ContentControl Template="{StaticResource PlusIcon}" />
                        </Button.Content>
                        <Button.LayoutTransform>
                            <ScaleTransform ScaleX="0.7"
                                            ScaleY="0.7" />
                        </Button.LayoutTransform>
                        <Button.ToolTip>
                            <TextBlock Text="Add Scene" />
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="DeleteSceneButton"
                            Style="{StaticResource BorderWidgetsButton}"
                            Width="40"
                            Height="40"
                            Margin="5 2 5 2"
                            Click="ScenesListDeleteMenuItem_Click">
                        <Button.Content>
                            <ContentControl Template="{StaticResource CancelIcon}"
                                            Foreground="White" />
                        </Button.Content>
                        <Button.LayoutTransform>
                            <ScaleTransform ScaleX="0.7"
                                            ScaleY="0.7" />
                        </Button.LayoutTransform>
                        <Button.ToolTip>
                            <TextBlock Text="Delete Scene" />
                        </Button.ToolTip>
                    </Button>
                </WrapPanel>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
