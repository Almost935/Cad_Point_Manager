<UserControl x:Class="Cad_Point_Manager.Views.UserControls.ColorToggle"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cad_Point_Manager.Views.UserControls"
             xmlns:converters="clr-namespace:Cad_Point_Manager.Converters"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:Vector4ToBrushConverter x:Key="Vector4ToBrushConverter" />
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="ToggleButton"
                      Width="{Binding ElementName=root, Path=ToggleButtonWidth}"
                      Height="{Binding ElementName=root, Path=ToggleButtonHeight}"
                      Background="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vector4ToBrushConverter}}"
                      BorderBrush="Black"
                      BorderThickness="1"
                      IsChecked="{Binding ElementName=root, Path=IsPopupOpen, Mode=TwoWay}" 
                      Margin="{Binding ElementName=root, Path=ToggleButtonMargin}"/>
        <Popup IsOpen="{Binding ElementName=root, Path=IsPopupOpen}"
               StaysOpen="False"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=ToggleButton}">
            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Background="White">
                <xctk:ColorCanvas x:Name="ColorCanvas"
                                  Width="260"
                                  Height="200"
                                  SelectedColorChanged="ColorCanvas_SelectedColorChanged" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
