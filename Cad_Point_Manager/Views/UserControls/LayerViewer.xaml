<UserControl x:Class="Cad_Point_Manager.Views.UserControls.LayerViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cad_Point_Manager.Views.UserControls"
             xmlns:controls="clr-namespace:Cad_Point_Manager.Controls"
             xmlns:converters="clr-namespace:Cad_Point_Manager.Converters"
             xmlns:viewModels="clr-namespace:Cad_Point_Manager.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="300">
    <Grid x:Name="overallGrid"
          MouseLeave="overallGrid_MouseLeave"
          MouseEnter="overallGrid_MouseEnter">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="mainPanel"
                HorizontalAlignment="Stretch"
                Grid.Column="0"
                RenderTransformOrigin="1, 1">
            <ListView x:Name="layersListView"
                      ItemsSource="{Binding JobFileManager.CadManager3D.LayersView}"
                      Style="{StaticResource LayersListViewStyle}"
                      FontSize="14" 
                      SelectionMode="Extended"
                      Loaded="layersListView_Loaded"
                      SizeChanged="layersListView_SizeChanged"
                      SelectionChanged="layersListView_SelectionChanged"
                      Background="#BF000000">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=Value.Name}"
                                               Foreground="White"
                                               FontSize="12"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="2 0 0 0">
                                        <TextBlock.ToolTip>
                                            <TextBlock Text="{Binding Path=Value.Name}" />
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Visibilty">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Path=Value.IsVisible, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Checked="CheckBox_Checked"
                                              Unchecked="CheckBox_Unchecked"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border x:Name="tab"
                Background="#FF797979"
                Grid.Column="1">
            <Grid>
                <TextBlock Text="Layers"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           RenderTransformOrigin="0.5, 0.5"
                           ClipToBounds="False"
                           Margin="0 2 4 2">
                    <TextBlock.LayoutTransform>
                        <TransformGroup>
                            <RotateTransform Angle="90" />
                            <ScaleTransform ScaleX="-1"
                                            ScaleY="-1" />
                        </TransformGroup>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Grid>
        </Border>

    </Grid>
</UserControl>
