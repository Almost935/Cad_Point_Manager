<UserControl x:Class="Cad_Point_Manager.Views.UserControls.LayoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:Cad_Point_Manager.Views.UserControls"
             xmlns:local="clr-namespace:Cad_Point_Manager.Views.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="24"
             d:DesignWidth="36"
             DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}">
    <Grid Background="White"
          Height="{Binding Layout.PageHeightIn, FallbackValue=24}"
          Width="{Binding Layout.PageWidthIn, FallbackValue=36}">
        <uc:LayoutPreviewControl Renderer="{Binding Renderer}"
                                 Layout="{Binding Layout}"
                                 Scenes="{Binding Scenes}" />
    </Grid>
</UserControl>
