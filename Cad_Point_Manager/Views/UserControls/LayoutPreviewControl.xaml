<UserControl x:Class="Cad_Point_Manager.Views.UserControls.LayoutPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cad_Point_Manager.Views.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <!-- Viewbox scales the page to fit the available space -->
        <Viewbox x:Name="FitViewbox"
                 Stretch="Uniform"
                 StretchDirection="DownOnly">
            <!-- Container holds the page at its "true" DIP size -->
            <Canvas x:Name="RootCanvas" />
        </Viewbox>
    </Grid>
</UserControl>
