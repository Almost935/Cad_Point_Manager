<Window x:Class="Cad_Point_Manager.Views.InputWindows.PointNumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cad_Point_Manager.Views.InputWindows"
        xmlns:controls="clr-namespace:Cad_Point_Manager.Controls"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        mc:Ignorable="d"
        Title="PointNumberDialog"
        d:DataContext="{d:DesignInstance Type=local:PointNumberDialog}"
        Height="400"
        Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="Transparent"
        AllowsTransparency="False"
        BorderThickness="0">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#0078D4" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#0078D4" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="10,4" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="IsEnabled"
                    Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasErrors}"
                             Value="True">
                    <Setter Property="IsEnabled"
                            Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#FFFFFF" />
            <Setter Property="Foreground"
                    Value="#1F1F1F" />
            <Setter Property="BorderBrush"
                    Value="#D0D0D0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="10,4" />
            <Setter Property="Cursor"
                    Value="Hand" />
        </Style>
        <Style x:Key="Win11CloseButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="#1F1F1F" />
            <Setter Property="FontSize"
                    Value="10" />
            <Setter Property="FontFamily"
                    Value="Segoe UI Symbol" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="bg"
                              Background="Transparent">
                            <Viewbox Margin="2">
                                <ContentControl x:Name="closeIcon"
                                                Template="{StaticResource CloseIcon}"
                                                Foreground="#FFC8C8C8" />
                            </Viewbox>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bg"
                                        Property="Background"
                                        Value="#E81123" />
                                <Setter TargetName="closeIcon"
                                        Property="Foreground"
                                        Value="White" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="bg"
                                        Property="Background"
                                        Value="#E81123" />
                                <Setter Property="Foreground"
                                        Value="White" />
                                <Setter TargetName="closeIcon"
                                        Property="Foreground"
                                        Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:SortableListView x:Name="ConflictsListView"
                                   Style="{StaticResource UpdatedListViewStyle}"
                                   ItemsSource="{Binding ImportConflicts}"
                                   Loaded="ListView_Loaded"
                                   SizeChanged="ConflictsListView_SizeChanged">
            <controls:SortableListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource UpdatedGridViewColumnHeaderStyle}">
                    <GridViewColumn Header="Current Number">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExistingPointNumber}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="New Number">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewPointNumberText,
                                UpdateSourceTrigger=PropertyChanged,
                                ValidatesOnNotifyDataErrors=True}"
                                         VerticalAlignment="Center"
                                         Margin="5 2 20 2"
                                         Style="{StaticResource ValidationTextBox}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </controls:SortableListView.View>
        </controls:SortableListView>
        <Border Grid.Row="2"
                Padding="12">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="AutoNumberButton"
                        Content="Auto Number"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="10"
                        Click="AutoNumberButton_Click" />
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="60"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="10" 
                        Click="CancelButton_Click"/>
                <Button x:Name="ImportButton"
                        Content="Import"
                        Width="60"
                        Style="{StaticResource PrimaryButtonStyle}"
                        FontSize="10"
                        Click="ImportButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
