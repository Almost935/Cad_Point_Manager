<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Cad_Point_Manager.Controls">

    <Style x:Key="LayoutsListViewScrollViewer"
           TargetType="ScrollViewer">
        <Style.Resources>
            <SolidColorBrush x:Key="HeaderForeground"
                             Color="White" />
            <SolidColorBrush x:Key="ColumnHeaderBorderBackground"
                             Color="#FF747781" />
            <SolidColorBrush x:Key="ScrollBarBackgroundBrush"
                             Color="#FF747781" />
            <SolidColorBrush x:Key="ScrollBarThumbBrush"
                             Color="#FF999897" />
            <Style x:Key="HeaderBorderStyle"
                   TargetType="Border">
                <Style.Setters>
                    <Setter Property="Background"
                            Value="{StaticResource ColumnHeaderBorderBackground}" />
                    <Setter Property="Margin"
                            Value="0.5 1 0.5 1" />
                    <Setter Property="IsHitTestVisible"
                            Value="False" />
                </Style.Setters>
            </Style>
            <Style x:Key="HeaderTextBlockStyle"
                   TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin"
                            Value="5 0.5 5 0.5" />
                    <Setter Property="Foreground"
                            Value="{StaticResource HeaderForeground}" />
                    <Setter Property="FontSize"
                            Value="11" />
                    <Setter Property="VerticalAlignment"
                            Value="Center" />
                </Style.Setters>
            </Style>
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Column headers -->
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Focusable="False">
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="1.35*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource HeaderBorderStyle}"
                                        Grid.Column="0">
                                    <TextBlock Text="Name"
                                               Style="{StaticResource HeaderTextBlockStyle}" />
                                </Border>
                                <Border Style="{StaticResource HeaderBorderStyle}"
                                        Grid.Column="1">
                                    <TextBlock Text="Page Width"
                                               Style="{StaticResource HeaderTextBlockStyle}" />
                                </Border>
                                <Border Style="{StaticResource HeaderBorderStyle}"
                                        Grid.Column="2">
                                    <TextBlock Text="Page Height"
                                               Style="{StaticResource HeaderTextBlockStyle}" />
                                </Border>
                                <Border Style="{StaticResource HeaderBorderStyle}"
                                        Grid.Column="3">
                                    <TextBlock Text="Scene"
                                               Style="{StaticResource HeaderTextBlockStyle}" />
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- Items -->
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Row="1"
                                                KeyboardNavigation.DirectionalNavigation="Local"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False"
                                                CanVerticallyScroll="True" />

                        <!-- Horizontal scrollbar -->
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="2"
                                   Orientation="Horizontal"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />

                        <!-- Vertical scrollbar -->
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Grid.RowSpan="3"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Column header grip (Thumb) -->
    <Style x:Key="LayoutsListViewThumb"
           TargetType="Thumb">
        <Setter Property="Width"
                Value="100" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="{DynamicResource ListViewThumbLightColor}"
                                  Offset="0.0" />
                    <GradientStop Color="{DynamicResource ListViewThumbDarkColor}"
                                  Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Padding="0"
                            Background="Transparent">
                        <Rectangle HorizontalAlignment="Center"
                                   Fill="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListViewItem -->
    <Style  x:Key="LayoutsListViewItem"
            TargetType="{x:Type controls:DoubleClickSetListViewItem}">
        <Style.Resources>
            <SolidColorBrush x:Key="SelectedBackgroundBrush"
                             Color="#BF5F5F5F" />
            <SolidColorBrush x:Key="MouseOverBackgroundBrush"
                             Color="#BF808080" />
            <SolidColorBrush x:Key="ActiveBrush"
                             Color="#BF4FFF62" />
            <SolidColorBrush x:Key="ActiveMouseOverBrush"
                             Color="#B200840E" />
            <SolidColorBrush x:Key="ActiveSelectedBrush"
                             Color="#B200630B" />
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels"
                Value="true" />
        <Setter Property="OverridesDefaultStyle"
                Value="False" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Stretch" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DoubleClickSetListViewItem}">
                    <Border x:Name="Border"
                            SnapsToDevicePixels="true"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="0"
                            Padding="0">
                        <ContentPresenter Grid.Column="0"
                                          Content="{Binding}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />

                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive"
                                           Value="true" />
                                <Condition Property="IsMouseOver"
                                           Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{DynamicResource ActiveBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive"
                                           Value="true" />
                                <Condition Property="IsMouseOver"
                                           Value="true" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{DynamicResource ActiveMouseOverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive"
                                           Value="true" />
                                <Condition Property="IsSelected"
                                           Value="true" />
                                <Condition Property="IsMouseOver"
                                           Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{DynamicResource ActiveSelectedBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive"
                                           Value="false" />
                                <Condition Property="IsMouseOver"
                                           Value="true" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{DynamicResource MouseOverBackgroundBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive"
                                           Value="false" />
                                <Condition Property="IsSelected"
                                           Value="true" />
                                <Condition Property="IsMouseOver"
                                           Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{DynamicResource SelectedBackgroundBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListView -->
    <Style x:Key="LayoutsListView"
           TargetType="{x:Type controls:DoubleClickSetListView}">
        <Style.Resources>
            <SolidColorBrush x:Key="ListView.Static.Border"
                             Color="#999897" />
            <SolidColorBrush x:Key="ListView.Disabled.Background"
                             Color="#FFCCCCCC" />
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="OverridesDefaultStyle"
                Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll"
                Value="True" />
        <Setter Property="VerticalContentAlignment"
                Value="Stretch" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource LayoutsListViewItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DoubleClickSetListView}">
                    <Border x:Name="Border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Padding="0">
                        <ScrollViewer Style="{StaticResource LayoutsListViewScrollViewer}"
                                      Padding="0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>