<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Cad_Point_Manager.Converters">
    
    <converters:Vector4ToBrushConverter x:Key="Vector4ToBrushConverter" />
    
    <Style x:Key="CogoPointTextBlockStyle"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{Binding PointGroup.Color, Converter={StaticResource Vector4ToBrushConverter}, FallbackValue=Red}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                         Value="True">
                <Setter Property="Foreground"
                        Value="{StaticResource MouseOverBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CogoPointEllipseStyle"
           TargetType="Ellipse">
        <Setter Property="Fill"
                Value="{Binding PointGroup.Color, Converter={StaticResource Vector4ToBrushConverter}, FallbackValue=Red}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                         Value="True">
                <Setter Property="Fill"
                        Value="{StaticResource MouseOverBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CogoPointGridStyle"
           TargetType="Grid">
        <Setter Property="Background"
                Value="{x:Null}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                         Value="True">
                <Setter Property="Background"
                        Value="{StaticResource MouseOverBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>