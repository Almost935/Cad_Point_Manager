<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF">

    <Style x:Key="ScrollBarArrowButtonStyle"
           TargetType="RepeatButton">
        <Setter Property="Foreground"
                Value="#FF6A6A6A" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bg"
                            CornerRadius="2"
                            Padding="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="#55000000" />
                            <Setter Property="Foreground"
                                    Value="#FFB0B0B0" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="#77000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CustomVerticalScrollBar"
           TargetType="ScrollBar">
        <Style.Resources>
            <SolidColorBrush x:Key="TrackBackgroundBrush"
                             Color="Transparent" />
            <SolidColorBrush x:Key="MouseOverTrackBackgroundBrush"
                             Color="#4C444444" />
            <SolidColorBrush x:Key="ThumbBrush"
                             Color="#FF6A6A6A" />
            <!--<SolidColorBrush x:Key="MouseOverThumbBrush"
                             Color="#FF949494" />
            <SolidColorBrush x:Key="DraggingThumbBrush"
                             Color="#FF828282" />-->
            <SolidColorBrush x:Key="MouseOverThumbBrush"
                             Color="#FF6A6A6A" />
            <SolidColorBrush x:Key="DraggingThumbBrush"
                             Color="#FF6A6A6A" />
        </Style.Resources>
        <!--<Setter Property="Background"
                Value="#22000000" />-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="TrackBg"
                          Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <RepeatButton x:Name="pageUpButton"
                                      Visibility="Hidden"
                                      Grid.Row="0"
                                      Command="ScrollBar.LineUpCommand"
                                      Style="{StaticResource ScrollBarArrowButtonStyle}">
                            <RepeatButton.Content>
                                <fa:FontAwesome Icon="ChevronUp"
                                                Foreground="{TemplateBinding Foreground}" />
                            </RepeatButton.Content>
                        </RepeatButton>

                        <Track x:Name="PART_Track"
                               Grid.Row="1"
                               Orientation="{TemplateBinding Orientation}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               IsDirectionReversed="True">

                            <!--REQUIRED: Decrease + Increase buttons (can be invisible)-->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource ScrollBarArrowButtonStyle}" />
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource ScrollBarArrowButtonStyle}" />
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="border"
                                                    Background="{StaticResource ThumbBrush}"
                                                    CornerRadius="6"
                                                    Width="6" />
                                            <!--<ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter TargetName="border"
                                                            Property="Background"
                                                            Value="{StaticResource MouseOverThumbBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging"
                                                         Value="True">
                                                    <Setter TargetName="border"
                                                            Property="Background"
                                                            Value="{StaticResource DraggingThumbBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>-->
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>

                        <RepeatButton x:Name="pageDownButton"
                                      Visibility="Hidden"
                                      Grid.Row="2"
                                      Command="ScrollBar.LineDownCommand"
                                      Style="{StaticResource ScrollBarArrowButtonStyle}">
                            <RepeatButton.Content>
                                <fa:FontAwesome Icon="ChevronDown"
                                                Foreground="{TemplateBinding Foreground}" />
                            </RepeatButton.Content>
                        </RepeatButton>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="TrackBg"
                                 Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    TargetName="TrackBg"
                                    Value="{DynamicResource MouseOverTrackBackgroundBrush}" />
                            <Setter Property="Visibility"
                                    Value="Visible"
                                    TargetName="pageUpButton" />
                            <Setter Property="Visibility"
                                    Value="Visible"
                                    TargetName="pageDownButton" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>