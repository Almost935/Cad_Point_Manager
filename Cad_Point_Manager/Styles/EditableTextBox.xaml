<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Cad_Point_Manager.Converters">
    
    <converters:FirstValidationErrorConverter x:Key="FirstValidationErrorConverter" />
    
    <Style TargetType="TextBox"
           x:Key="EditableTextBox">
        <Style.Resources>
            <SolidColorBrush x:Key="Border.Static.Background"
                             Color="White" />
            <SolidColorBrush x:Key="Border.Static.Border"
                             Color="Black" />
        </Style.Resources>
        
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="Focusable"
                Value="true" />
        <Setter Property="KeyboardNavigation.TabNavigation"
                Value="None" />
        <Setter Property="AllowDrop"
                Value="true" />
        <Setter Property="MinWidth"
                Value="30" />
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <AdornedElementPlaceholder />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Name="Border"
                            CornerRadius="2"
                            BorderThickness="1"
                            Background="{DynamicResource Border.Static.Background}"
                            BorderBrush="{DynamicResource Border.Static.Border}"
                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                        <ScrollViewer Margin="0"
                                      x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsReadOnly"
                                 Value="True">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="Transparent" />
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="Transparent" />
                            <Setter Property="SelectionOpacity"
                                    Value="0" />
                            <Setter Property="Cursor"
                                    Value="Arrow" />
                            <Setter Property="IsEnabled"
                                    Value="False" />
                        </Trigger>

                        <Trigger Property="Validation.HasError"
                                 Value="True">
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource FirstValidationErrorConverter}">
                                        <Binding Path="(Validation.HasError)"
                                                 RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="(Validation.Errors)"
                                                 RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="ToolTip"
                                                 RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{StaticResource ErrorBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError"
                                 Value="False">
                            <Setter Property="ToolTip"
                                    Value="{Binding Text, 
                                                RelativeSource={RelativeSource Self}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>