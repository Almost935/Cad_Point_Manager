<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DefaultContextMenuItemStyle"
           TargetType="{x:Type MenuItem}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource ContextMenuForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="HoverBorder"
                            Background="Transparent"
                            CornerRadius="2"
                            Grid.ColumnSpan="3"
                            Padding="2 3 2 3"
                            Margin="2 3 2 3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="IconCol" />
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="HeaderCol" />
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="GestureCol" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Icon"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="6 0 6 0" />
                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Header}"
                                       Margin="4 0 25 0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Foreground="Black" />
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource ContextMenuForegroundBrush}"
                                       Margin="6 0 6 0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted"
                                 Value="True">
                            <Setter TargetName="HoverBorder"
                                    Property="Background"
                                    Value="#19000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="#AAA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type ContextMenu}"
           x:Key="Win11ContextMenuStyle">
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="Background"
                Value="#F9F9FB" />
        <Setter Property="BorderBrush"
                Value="#33000000" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize"
                Value="{StaticResource ContextMenuFontSize}" />
        <Setter Property="HasDropShadow"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border CornerRadius="4"
                            ClipToBounds="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                                              ShadowDepth="4"
                                              Opacity="0.3"
                                              Color="#FF383838" />
                        </Border.Effect>
                        <Border Background="White"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"
                                Margin="0 0 10 10">
                            <StackPanel IsItemsHost="True"
                                        Grid.IsSharedSizeScope="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Win11SeparatorStyle"
           TargetType="{x:Type Separator}">
        <Setter Property="Margin"
                Value="2,3,2,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1"
                            Background="#22000000"
                            HorizontalAlignment="Stretch"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>