<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <ControlTemplate x:Key="EverythingIcon">
        <Canvas Width="32"
                Height="32">
            <Path Stroke="White"
                  StrokeThickness="1">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="2,16"
                                    IsClosed="False">
                            <ArcSegment Point="16,16"
                                        Size="7,7"
                                        SweepDirection="Clockwise" />
                            <ArcSegment Point="2,16"
                                        Size="7,7"
                                        SweepDirection="Clockwise" />
                        </PathFigure>
                        <PathFigure StartPoint="30,16"
                                    IsClosed="False">
                            <ArcSegment Point="16,16"
                                        Size="7,7"
                                        SweepDirection="Clockwise" />
                            <ArcSegment Point="30,16"
                                        Size="7,7"
                                        SweepDirection="Clockwise" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>
    </ControlTemplate>

    <ControlTemplate x:Key="LineIcon">
        <Canvas Height="32"
                Width="32">
            <Line X1="4"
                  Y1="4"
                  X2="28"
                  Y2="28"
                  Stroke="White" />
        </Canvas>
    </ControlTemplate>

    <ControlTemplate x:Key="PointsIcon">
        <Canvas Height="32"
                Width="32">
            <Ellipse Width="4"
                     Height="4"
                     Stroke="White"
                     Fill="White"
                     Canvas.Left="14"
                     Canvas.Top="6" />
            <Ellipse Width="4"
                     Height="4"
                     Stroke="White"
                     Fill="White"
                     Canvas.Left="4"
                     Canvas.Top="22" />
            <Ellipse Width="4"
                     Height="4"
                     Stroke="White"
                     Fill="White"
                     Canvas.Left="24"
                     Canvas.Top="22" />
        </Canvas>
    </ControlTemplate>
</ResourceDictionary>