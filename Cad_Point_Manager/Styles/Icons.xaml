<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Snap Icons-->
    <ControlTemplate x:Key="IntersectionSnapIcon">
        <Canvas Width="16"
                Height="16"
                Background="Transparent"
                RenderTransformOrigin="1 1">
            <Line Stroke="{StaticResource MouseOverBrush}"
                  StrokeThickness="1"
                  X1="8"
                  Y1="2"
                  X2="8"
                  Y2="14"
                  StrokeDashCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" />
            <Line Stroke="{StaticResource MouseOverBrush}"
                  StrokeThickness="1"
                  X1="2"
                  Y1="8"
                  X2="14"
                  Y2="8"
                  StrokeDashCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" />

            <Canvas.RenderTransform>
                <ScaleTransform ScaleX="2"
                                ScaleY="2" />
            </Canvas.RenderTransform>
        </Canvas>
    </ControlTemplate>
    <ControlTemplate x:Key="EndSnapIcon">
        <Canvas Width="16"
                Height="16"
                Background="Transparent"
                RenderTransformOrigin="1 1">
            <Line Stroke="{StaticResource MouseOverBrush}"
                  StrokeThickness="1"
                  X1="2"
                  Y1="8"
                  X2="14"
                  Y2="8"
                  StrokeDashCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" />
            <Ellipse Width="3"
                     Height="3"
                     Canvas.Left="1"
                     Canvas.Top="6.5"
                     Fill="{StaticResource MouseOverBrush}" />

            <Canvas.RenderTransform>
                <ScaleTransform ScaleX="2"
                                ScaleY="2" />
            </Canvas.RenderTransform>
        </Canvas>
    </ControlTemplate>
    <ControlTemplate x:Key="MidPointSnapIcon">
        <Canvas Width="16"
                Height="16"
                Background="Transparent"
                RenderTransformOrigin="1 1">
            <Line Stroke="{StaticResource MouseOverBrush}"
                  StrokeThickness="1"
                  X1="2"
                  Y1="8"
                  X2="14"
                  Y2="8"
                  StrokeDashCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" />
            <Ellipse Width="3"
                     Height="3"
                     Canvas.Left="6.5"
                     Canvas.Top="6.5"
                     Fill="{StaticResource MouseOverBrush}" />

            <Canvas.RenderTransform>
                <ScaleTransform ScaleX="2"
                                ScaleY="2" />
            </Canvas.RenderTransform>
        </Canvas>
    </ControlTemplate>


    <ControlTemplate x:Key="CogoPointsIcon">
        <Canvas Width="32"
                Height="32">
            <Ellipse Width="20"
                     Height="20"
                     Stroke="White"
                     Canvas.Left="6"
                     Canvas.Top="6" />
            <Line X1="4"
                  Y1="4"
                  X2="28"
                  Y2="28"
                  Stroke="White" />
            <Line X1="28"
                  Y1="4"
                  X2="4"
                  Y2="28"
                  Stroke="White" />
        </Canvas>
    </ControlTemplate>

    <ControlTemplate x:Key="EverythingIcon">
        <Canvas Width="32"
                Height="32">
            <Path Stroke="White"
                  StrokeThickness="1">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="2,16"
                                    IsClosed="False">
                            <ArcSegment Point="16,16"
                                        Size="7,7"
                                        SweepDirection="Clockwise" />
                            <ArcSegment Point="2,16"
                                        Size="7,7"
                                        SweepDirection="Clockwise" />
                        </PathFigure>
                        <PathFigure StartPoint="30,16"
                                    IsClosed="False">
                            <ArcSegment Point="16,16"
                                        Size="7,7"
                                        SweepDirection="Clockwise" />
                            <ArcSegment Point="30,16"
                                        Size="7,7"
                                        SweepDirection="Clockwise" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>
    </ControlTemplate>

    <ControlTemplate x:Key="LineIcon">
        <Canvas Height="32"
                Width="32">
            <Line X1="4"
                  Y1="4"
                  X2="28"
                  Y2="28"
                  Stroke="White" />
        </Canvas>
    </ControlTemplate>

    <ControlTemplate x:Key="PointsIcon">
        <Canvas Height="32"
                Width="32">
            <Ellipse Width="4"
                     Height="4"
                     Stroke="White"
                     Fill="White"
                     Canvas.Left="14"
                     Canvas.Top="6" />
            <Ellipse Width="4"
                     Height="4"
                     Stroke="White"
                     Fill="White"
                     Canvas.Left="4"
                     Canvas.Top="22" />
            <Ellipse Width="4"
                     Height="4"
                     Stroke="White"
                     Fill="White"
                     Canvas.Left="24"
                     Canvas.Top="22" />
        </Canvas>
    </ControlTemplate>
</ResourceDictionary>