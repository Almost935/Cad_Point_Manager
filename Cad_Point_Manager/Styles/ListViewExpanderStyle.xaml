<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Expander"
           x:Key="ListViewExpanderStyle">
        <Style.Resources>
            <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke"
                             Color="#FF6C6C6C" />
            <SolidColorBrush x:Key="Expander.Static.Arrow.Fill"
                             Color="Transparent" />
            <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke"
                             Color="#FF4B4B4B" />
            <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Fill"
                             Color="#FF4B4B4B" />
            <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke"
                             Color="#FF4B4B4B" />
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                Margin="{TemplateBinding Margin}">
                        <ToggleButton x:Name="ExpanderToggle"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      HorizontalContentAlignment="Left"
                                      Padding="4,2"
                                      Content="{TemplateBinding Header}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel x:Name="stackPanel"
                                                Orientation="Horizontal">
                                        <Border CornerRadius="1">
                                            <Path x:Name="Arrow"
                                                  Width="15"
                                                  Height="15"
                                                  Stroke="{DynamicResource Expander.Static.Arrow.Stroke}"
                                                  Fill="{DynamicResource Expander.Static.Arrow.Fill}"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Left"
                                                  Data="M 0 0 L 10 0 L 5 5 Z"
                                                  RenderTransformOrigin="0.5,0.5">
                                            </Path>
                                        </Border>
                                        <ContentPresenter x:Name="content"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"
                                                          Margin="5 0 0 0" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked"
                                                 Value="True">
                                            <Setter TargetName="Arrow"
                                                    Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="-90" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="Arrow"
                                                    Property="Stroke"
                                                    Value="{DynamicResource Expander.MouseOver.Arrow.Stroke}" />
                                            <Setter TargetName="Arrow"
                                                    Property="Fill"
                                                    Value="{DynamicResource Expander.MouseOver.Arrow.Fill}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="Arrow"
                                                    Property="Stroke"
                                                    Value="{DynamicResource Expander.MouseOver.Arrow.Stroke}" />
                                            <Setter TargetName="Arrow"
                                                    Property="Fill"
                                                    Value="{DynamicResource Expander.MouseOver.Arrow.Fill}" />
                                            <Setter TargetName="stackPanel"
                                                    Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="{Binding Source={StaticResource Expander.MouseOver.Arrow.Stroke}, Path=Color}"
                                                                      BlurRadius="7"
                                                                      ShadowDepth="3"
                                                                      Opacity="0.7" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpanderContent"
                                          Margin="0"
                                          ContentSource="Content" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded"
                                 Value="False">
                            <Setter TargetName="ExpanderContent"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>