<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Cad_Point_Manager.Controls">
    <system:Double x:Key="strokeThickness">0.03</system:Double>
    <Thickness x:Key="borderThickness">0.03</Thickness>

    <!-- Converter: bool -> Visibility -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Optional: subtle visual cue brush -->
    <SolidColorBrush x:Key="EditableHoverBrush"
                     Color="#20000000" />

    <!-- Inline editable text template -->
    <Style x:Key="InlineEditableTextStyle"
           TargetType="{x:Type controls:TemplateInlineEditableTextControl}">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TemplateInlineEditableTextControl}">
                    <Border x:Name="RootBorder"
                            Background="Transparent"
                            Padding="0.10"
                            CornerRadius="0.10"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="ReadView"
                                       Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="Arial"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap"
                                       Cursor="IBeam" />

                            <Border x:Name="Underline"
                                    BorderBrush="Black"
                                    BorderThickness="0,0,0,0.02"
                                    VerticalAlignment="Bottom"
                                    Opacity="0.35"
                                    Margin="0,0,0,-0.02" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="RootBorder"
                                    Property="Background"
                                    Value="{StaticResource EditableHoverBrush}" />
                            <Setter TargetName="Underline"
                                    Property="Opacity"
                                    Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>