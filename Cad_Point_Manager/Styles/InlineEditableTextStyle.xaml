<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Cad_Point_Manager.Controls"
                    xmlns:converters="clr-namespace:Cad_Point_Manager.Converters">
    <system:Double x:Key="strokeThickness">0.03</system:Double>
    <Thickness x:Key="borderThickness">0.03</Thickness>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:MultiplyConverter x:Key="LineHeightAdjustConverter"
                                  Factor="1.4" />

    <SolidColorBrush x:Key="EditableHoverBrush"
                     Color="#20000000" />
    <SolidColorBrush x:Key="HoverBrush"
                     Color="DeepSkyBlue" />

    <!-- Inline editable text template -->
    <Style x:Key="InlineEditableTextStyle"
           TargetType="{x:Type controls:TemplateInlineEditableTextControl}">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TemplateInlineEditableTextControl}">
                    <Grid ClipToBounds="False">
                        <Border x:Name="RootBorder"
                                BorderThickness="0"
                                BorderBrush="{StaticResource HoverBrush}"
                                CornerRadius="0.05"
                                Margin="-0.05"
                                SnapsToDevicePixels="True"
                                ClipToBounds="False" />
                        <TextBlock x:Name="ReadView"
                                   Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="Arial"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextWrapping="Wrap"
                                   Cursor="IBeam"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LineHeightAdjustConverter}}"
                                   ClipToBounds="False" />
                        <TextBlock x:Name="HoverText"
                                   Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="Arial"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{StaticResource HoverBrush}"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"
                                   Cursor="IBeam"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LineHeightAdjustConverter}}"
                                   Opacity="0.8"
                                   ClipToBounds="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="RootBorder"
                                    Property="BorderThickness"
                                    Value="0.03" />
                            <Setter TargetName="HoverText"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>