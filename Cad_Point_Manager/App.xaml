                <ResourceDictionary Source="Styles/BorderWidgetsButton.xaml" />
                <ResourceDictionary Source="Styles/BorderWidgetsToggleButton.xaml" />
                <ResourceDictionary Source="Styles/ValidationComboBox.xaml" />
                <ResourceDictionary Source="Styles/ContextMenuStyle.xaml" />
                <ResourceDictionary Source="Styles/TextBoxStyles.xaml" />
                <ResourceDictionary Source="Styles/DoubleClickActiveListView.xaml" />
                <ResourceDictionary Source="Styles/TabControlStyle.xaml" />
                <ResourceDictionary Source="Styles/InlineEditableTextStyle.xaml" />
