<UserControl x:Class="Cad_Point_Manager.Controls.AutoHideControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cad_Point_Manager.Controls"
             d:DataContext="{d:DesignInstance Type=local:Direct2DDxfControl}"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="500">
    <Grid>
        <!-- Main Panel -->
        <Border x:Name="MainPanel"
                Background="LightGray"
                Width="300"
                Height="500"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="Visible"
                MouseEnter="MainPanel_MouseEnter"
                MouseLeave="MainPanel_MouseLeave">
            <!-- Content -->
            <TextBlock Text="Expandable Content"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Tab -->
        <Rectangle x:Name="Tab"
                   Fill="Gray"
                   Width="50"
                   Height="100"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   MouseEnter="Tab_MouseEnter"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
