<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="MainBackgroundBrush"
                     Color="#282D33" />
    <SolidColorBrush x:Key="WidgetBrush"
                     Color="#FF3A4149" />
    
    <!--Tab Brushes-->
    <SolidColorBrush x:Key="TabColor"
                     Color="#FFC5C5C5" />
    <SolidColorBrush x:Key="TabMouseOverColor"
                     Color="#FF929292" />
    <SolidColorBrush x:Key="TabFontColor"
                     Color="Black" />
    <SolidColorBrush x:Key="PopoutMenuBackgroundColor"
                     Color="#7F505050" />
    
</ResourceDictionary>